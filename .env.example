# Environment variable contract — NAMES only. Do not write values here, not even example values (this file is copied).
# Single source: src/lib/env.ts. If a required name is missing or malformed, the application stops at startup and names it (never its value).
# Put the values into your hosting's environment variables (Vercel: Settings → Environment Variables) or into a local .env file; every other .env* file is git-ignored.

# Neon Postgres — pooled connection string (DATABASE_URL) and direct/unpooled connection string (DIRECT_URL)
DATABASE_URL=
DIRECT_URL=

# Encryption of your exchange API keys (AES-256-GCM).
# Master key: 32 bytes as base64, generated by `npm run key:encryption-master` (the value lives only in your backup folder). Version: a whole number ≥ 1, stored with each row (1 on a fresh installation).
# PREVIOUS: leave EMPTY. It is filled only during a master-key rotation (`npm run rotate:encryption-key`, a dry run by default; add `-- --write` to write) and removed afterwards.
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_VERSION=
ENCRYPTION_MASTER_KEY_PREVIOUS=

# Upstash Redis — request budget counter, execution lock, run-permit copy. Without it no call is made to Binance (fails closed).
# If you add Upstash through the Vercel Marketplace it sets KV_REST_API_URL / KV_REST_API_TOKEN instead; the app reads those names too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Owner sign-in, generated by `npm run owner:credentials` (the three lines of vercel-env-owner.txt).
# Password hash: scrypt. TOTP secret: 32 base32 characters. Session signing secret: 32 bytes as base64.
OWNER_PASSWORD_HASH=
OWNER_TOTP_SECRET=
SESSION_SECRET=

# Stop key hash (sha256 hex, 64 characters), generated by `npm run stop:credential`. The raw key is only in stop-key.txt and is typed on the /durdur screen.
STOP_KEY_HASH=

# Anthropic API key for the decision engine (Claude).
ANTHROPIC_API_KEY=

# Engine mode: CHEAP — the scheduled job (Vercel Cron) runs one tick per minute. The tick interval itself is a panel setting (Settings → Tick interval: every 1, 2 or 3 minutes), not a variable.
ENGINE_MODE=

# OPTIONAL — push notifications with your own Firebase project (off by default). Leave all three EMPTY and the app runs normally; the panel says notifications are off.
# Fill all three from your Firebase service-account JSON file (project_id, client_email, private_key) or none: with only some, notifications stay off and the panel names the variable (never its value).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
