# Ortam değişkeni sözleşmesi — yalnız İSİMLER. Değer yazma; örnek değer bile yazma (kopyalanır).
# Tek kaynak: src/lib/env.ts. Eksik/bozuk değişkende uygulama açılışta düşer.
# Değerler yalnız Vercel ortam değişkeni arayüzüne girer (E-2); bu dosya dışındaki .env* dosyaları .gitignore'dadır.

# G02 — Neon Postgres
DATABASE_URL=
DIRECT_URL=

# G03 — API anahtarı şifreleme (S-1, E-3; dönüş usulü A-1 açık)
# Ana anahtar: 32 bayt base64 (npm run key:encryption-master üretir; değer yalnız depo dışı yedekte). Sürüm: tamsayı ≥ 1, satıra yazılır.
# PREVIOUS: yalnız anahtar dönüşü sırasında dolu, sonra silinir. Dönüş aracı bu kopyada VARDIR: `npm run rotate:encryption-key` (varsayılan kuru koşum; yazmak için `-- --write`).
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_VERSION=
ENCRYPTION_MASTER_KEY_PREVIOUS=

# G05 sayaç (S-7) + G10 kilit (K-6) — Upstash Redis. Değer yoksa Binance'e çağrı ÇIKMAZ (kapalı arıza).
# Vercel Marketplace kaynağı bunları KV_REST_API_URL / KV_REST_API_TOKEN adıyla düşürür; sözleşme yoksa o adlardan okur (src/lib/env.ts UPSTASH_ALIAS, Tur 6).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# G04 — sahip kimliği (S-8). Karma: scrypt (npm run owner:credentials üretir). TOTP: 32 karakter base32. Oturum imzası: 32 bayt base64.
OWNER_PASSWORD_HASH=
OWNER_TOTP_SECRET=
SESSION_SECRET=

# Tur 6 — durdurma anahtarı karması (K-7). sha256 hex, 64 karakter (npm run stop:credential üretir; ham anahtar yalnız depo dışı yedekte).
STOP_KEY_HASH=

# G15 — Beyin (Claude API)
ANTHROPIC_API_KEY=

# Tur 21 — MOD ANAHTARI (tek ayar). CHEAP: Vercel cron dakikada bir tetikler, sürekli halka yok. FAST: zincir (Tur 19).
# Tur 67 — tik ARALIĞI burada DEĞİL: panel ayarıdır (brain_settings.tick_ms; 1 · 2 · 3 dakikada bir). ENGINE_TICK_MS artık okunmaz.
ENGINE_MODE=
